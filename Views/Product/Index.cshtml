@model IEnumerable<eshop.Models.Product>

@{
    ViewData["Title"] = "Proizvodi";
}

<h2>Popis proizvoda</h2>

@if (!Model.Any())
{
    <p>Nema proizvoda u bazi.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Naziv</th>
                <th>Cijena</th>
                <th>Opis</th>
                <th>Akcije</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Price.ToString("0.00") €</td>
                    <td>@product.Description</td>
                    <td>
                        <a asp-controller="Cart" asp-action="AddToCart" asp-route-productId="@product.Id" class="btn btn-success">
                            Dodaj u košaricu
                        </a>
                        <a asp-controller="Product" asp-action="Edit" asp-route-id="@product.Id" class="btn btn-primary">
                            Uredi
                        </a>
                        <a asp-controller="Product" asp-action="Delete" asp-route-id="@product.Id" class="btn btn-danger">
                            Obriši
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- ✅ Gumb za dodavanje novog proizvoda -->
<a asp-action="Create" class="btn btn-success mt-3">Dodaj novi proizvod</a>
